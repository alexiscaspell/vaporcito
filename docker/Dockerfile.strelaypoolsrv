FROM alpine
ARG TARGETARCH

EXPOSE 8080

RUN apk add --no-cache ca-certificates su-exec curl
ENV PUID=1000 PGID=1000 MAXMIND_KEY=

RUN mkdir /var/strelaypoolsrv && chown 1000 /var/strelaypoolsrv
USER 1000

# Expect prebuilt binary and scripts/ in the build context (repo root).
COPY back/strelaypoolsrv-linux-${TARGETARCH} /bin/strelaypoolsrv
COPY scripts/strelaypoolsrv-entrypoint.sh /bin/entrypoint.sh

WORKDIR /var/strelaypoolsrv
ENTRYPOINT ["/bin/entrypoint.sh", "/bin/strelaypoolsrv", "-listen", ":8080"]
