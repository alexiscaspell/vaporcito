{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/vaporcito",
          "sidecar": true,
          "args": [
            "serve",
            "--no-browser",
            "--no-restart",
            "--gui-address",
            {
              "validator": ".+"
            },
            "--home",
            {
              "validator": ".+"
            }
          ]
        }
      ]
    }
  ]
}
