{
  "name": "vaporcito-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:sidecar": "bash ./scripts/prepare-sidecar.sh",
    "prepare:sidecar:windows": "bash ./scripts/prepare-sidecar.sh windows",
    "desktop:dev": "bash ./scripts/prepare-sidecar.sh && npm run tauri dev",
    "desktop:build:linux": "bash ./scripts/build-linux.sh",
    "desktop:build:windows": "bash ./scripts/build-windows.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.3",
    "vite": "^8.0.16"
  }
}
